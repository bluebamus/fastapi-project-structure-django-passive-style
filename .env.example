# 이 파일을 `.env` 로 복사해 값을 채운다: cp .env.example .env
#
# 설정 검증(config.py) — 잘못된 설정은 기동 실패로 알려 준다(ENV=test 는 제외):
# - `.env` 가 없으면 ENV·비밀 키 3종·MYSQL_HOST/USER/PASSWORD/DATABASE 가 환경 변수로 모두
#   들어와야 한다(컨테이너 주입). 하나라도 없으면 기동하지 않는다.
# - 비밀 키 3종과 MYSQL_PASSWORD 가 아래 예시 값 그대로이거나 비어 있으면 **개발 환경에서도**
#   기동하지 않는다. 비밀 키는 32자 이상, access 와 refresh 는 서로 달라야 한다.
#   생성: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# - staging/production 은 추가로 DEBUG·LOG_LEVEL=DEBUG·SQL echo 를 거부한다.
#
# 배포 전에 해야 할 일 (README 「운영 배포 체크리스트」와 같은 목록):
# 1. TRUSTED_PROXY_HOPS — 프록시 뒤 배포면 앞단 프록시 단 수로 설정한다. 0 이면 모든 클라이언트가
#    프록시 IP 하나로 보여 접속 로그·로그인 레이트 리밋이 전체 사용자를 한 사람으로 취급한다.
#    실제보다 크게 잡으면 IP 위조가 가능하다.
# 2. KST→UTC 시각 마이그레이션(리비전 e5a7c2d9f310) — 기존 MySQL 값이 +09:00 으로 저장됐다고 가정한다.
#    다른 시간대였다면 적용 전에 리비전의 LEGACY_OFFSET 상수를 바꾼다. 적용 전 백업.
# 3. 첫 관리자 — scripts/create_superuser.py 로 만든다(대화형 또는 --password-stdin). /admin 로그인 계정이다.
# 4. /admin 은 슈퍼유저 로그인이 필요하다. 세션은 Redis 서버 세션이고, Redis 키는 SESSION_SECRET_KEY 로
#    만든 HMAC 이다(바꾸면 모든 관리 세션이 끊긴다). Redis 가 죽으면 관리 화면은 503 이다.
# 5. 관리 화면을 쓰지 않으면 ADMIN_DISABLED=true — 마운트도 링크도 없다.
#    예전 ADMIN 줄이 남아 있으면 기동이 멈춘다(ADMIN 이 false 였다면 ADMIN_DISABLED=true 로 바꾼다).

# =============================================================================
# 애플리케이션 설정
# =============================================================================
# 프로젝트 이름 (Scalar 문서 제목, 관리자 페이지 제목에 표시. 코드 기본값: FastAPI Project)
PROJECT_NAME=fastapi-project-structure-django-passive-style

# 애플리케이션 버전 (GET /health 응답의 version. 코드 기본값: 0.1.0)
VERSION=1.0.0

# 프로젝트 설명 (Scalar 문서에 표시)
# 미설정이면 config.API_DESCRIPTION(이 저장소 소개 Markdown)을 쓴다. 한 줄로 바꾸고 싶을 때만 지정한다.
# DESCRIPTION=Django 식 수동 앱 설치를 따르는 FastAPI 프로젝트 골격

# DEBUG 모드 설정 (기본값: true)
# - true: DEBUG 로그 출력, 개발용 테이블 자동 생성, /docs 활성화,
#         `python main.py` 직접 실행 시 reload (uvicorn CLI 는 CLI 옵션을 따른다)
# - false: INFO 로그만 출력, 테이블 자동 생성 비활성화 (Alembic 사용), /docs 비활성화
# DEBUG 로그에는 세션 롤백의 SQL·바인딩 값·트레이스백 전문이 들어간다 —
# ENV 가 staging/production 이면 true 일 때 기동이 거부된다 (LOG_LEVEL=DEBUG 도 동일).
DEBUG=true

# 관리 화면(SQLAdmin) 끄기 (기본값: false = 켜짐 — 개발 우선 구조라 의도된 기본값)
# - false: /admin 관리자 페이지 마운트 — 슈퍼유저 로그인 필요
# - true: 관리 화면 자체가 없다 — /admin 은 404, 앱의 어떤 응답(OpenAPI·/docs·오류 본문·헤더)에도
#         관리 화면 경로·링크가 나오지 않고 sqladmin 도 로드되지 않는다. 쓰지 않는 배포는 true.
# Note: DEBUG 설정과 독립적으로 동작합니다.
# ⚠️ 예전 이름 ADMIN 은 제거됐다(뜻이 뒤집힘). ADMIN 줄이 남아 있으면 기동이 실패한다 —
#    예전에 ADMIN 을 false 로 두었다면 ADMIN_DISABLED=true 로, true 였다면 그 줄을 지운다.
#
# 켜진 /admin 은 활성 슈퍼유저 로그인이 필요하다(Bootstrap 로그인 화면 → 세션 쿠키 admin_session,
# path=/admin·SameSite=Strict·HttpOnly, staging/production 에서는 Secure). 계정은
#   uv run python -m scripts.create_superuser --username admin --email admin@example.com
# 로 만든다. 쿠키에는 세션 ID 만 있고 내용은 Redis 에 있다(ADMIN_SESSION_* 만료). 권한은 매 요청
# DB 로 다시 확인한다. 생성·수정·삭제·로그아웃(POST) 등 상태를 바꾸는 요청은 CSRF 토큰이 필요하다.
# 로그인 시도는 API 로그인과 같은 AUTH_LOGIN_* 한도로 센다(초과 시 429 + Retry-After).
ADMIN_DISABLED=false

# 환경 설정: development(개발), staging(스테이징), production(운영), test(테스트)
# 로그 핸들러·타임존 선택과 설정 검증 범위(맨 위 설명)에 쓰인다 — 비밀키 placeholder·짧은 키·
# access/refresh 동일 키는 test 외 모든 ENV, DEBUG·LOG_SQL_ECHO_ENABLED 금지는 staging/production.
# staging/production 에서는 /admin 세션 쿠키에 Secure 가 붙는다(HTTPS 로만 전송).
# /health 응답에는 포함되지 않는다.
ENV=development

# `python main.py` 직접 실행 시 개발 서버 바인딩 호스트/포트.
# 0.0.0.0 은 컨테이너/외부 접근 허용용 기본값. 민감한 환경에서는 127.0.0.1 로 제한하고
# 리버스 프록시(nginx 등) 뒤에 두는 것을 권장한다.
#
# ADMIN_DISABLED=false + SERVER_HOST=0.0.0.0 이면 /admin 로그인 화면이 네트워크에 열린다(로그인은 필요하다).
# 관리 화면을 외부에 노출할 이유가 없으면 프록시에서 /admin 을 내부망으로 제한한다.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =============================================================================
# 타임존 설정
# =============================================================================
# 애플리케이션 지역 타임존 (로그 시각, 리포트·접속 로그 날짜 범위의 영업일 경계, Celery 일정 해석).
# DB 시각은 이 값과 무관하게 항상 UTC 로 저장된다(service-hardening ADR-010).
# 리포트 일자 버킷은 고정 오프셋이라 DST 가 없는 시간대를 전제한다.
# 예시: Asia/Seoul, UTC, America/New_York
TIME_ZONE=Asia/Seoul

# =============================================================================
# 데이터베이스 설정 (MySQL)
# =============================================================================
# MySQL 서버 호스트 (IP 또는 도메인)
MYSQL_HOST=localhost

# MySQL 서버 포트
MYSQL_PORT=3306

# MySQL 접속 사용자명
MYSQL_USER=root

# MySQL 접속 비밀번호 — 예시 값·빈 값이면 test 외 모든 ENV 에서 기동이 실패한다
MYSQL_PASSWORD=change-this-mysql-password

# 사용할 데이터베이스 이름
MYSQL_DATABASE=fastapi_db

# =============================================================================
# DB 라우터 (읽기/쓰기 분리)
# =============================================================================
# 라우터 사용 여부 (기본값: false)
# - false: 모든 쿼리가 위에서 설정한 단일 서버로 나간다 (기존 동작)
# - true : 세션이 구문 성격에 따라 엔진을 자동 선택한다
#          · ORM flush / INSERT·UPDATE·DELETE → primary(쓰기)
#          · SELECT                            → replica(읽기)
#          · 쓰기가 일어난 세션의 이후 SELECT  → primary 고정 (아래 STICKY 참고)
# 구현: app/core/db/router.py
DB_ROUTER_ENABLED=false

# 읽기 복제본(replication) 사용 여부 (기본값: false)
# - true 로 켜려면 DB_ROUTER_ENABLED=true 와 MYSQL_REPLICA_HOSTS 지정이 함께 필요하다.
#   (모순된 조합은 애플리케이션 기동 시점에 에러로 차단된다)
# - false: 라우터를 켜도 replica 가 없으므로 읽기도 primary 로 나간다.
DB_REPLICATION_ENABLED=false

# 쓰기 이후 같은 세션의 읽기를 primary 에 고정 (기본값: true, 권장)
# 복제 지연(replication lag) 때문에 방금 커밋한 행이 replica 에서 아직 안 보일 수 있다.
# false 로 두면 읽기 분산은 늘어나지만 read-after-write 일관성을 잃는다.
DB_READ_STICKY_AFTER_WRITE=true

# replica 호스트 목록 (JSON 배열, "host" 또는 "host:port" 형식)
# 여러 대를 지정하면 세션 단위 라운드로빈으로 분산된다.
# 호스트는 IP 주소와 도메인 이름을 모두 쓸 수 있고, 포트를 생략하면 MYSQL_REPLICA_PORT 를 쓴다.
#   IPv4   : ["10.0.0.11", "10.0.0.12:3307"]
#   도메인 : ["replica-a.example.com", "replica-b.example.com:3307"]
#   IPv6   : ["[2001:db8::10]:3307", "[::1]"]   ← 반드시 대괄호로 감쌀 것
# 예: MYSQL_REPLICA_HOSTS=["10.0.0.11", "replica-b.example.com:3307"]
MYSQL_REPLICA_HOSTS=[]

# 포트를 명시하지 않은 replica 에 적용할 기본 포트
MYSQL_REPLICA_PORT=3306

# replica 전용 자격증명 (비워두면 위 primary 값을 그대로 재사용)
# 읽기 전용 계정을 따로 두면 실수로 replica 에 쓰는 사고를 DB 권한으로 막을 수 있다.
# MYSQL_REPLICA_USER=readonly
# MYSQL_REPLICA_PASSWORD=change-this-replica-password
# MYSQL_REPLICA_DATABASE=fastapi_db

# =============================================================================
# 커넥션 풀
# =============================================================================
# 풀은 **프로세스마다** 만들어진다. 총 연결 수는
#   (DB_POOL_SIZE + DB_MAX_OVERFLOW) x (1 + replica 대수)
#   + (DB_BACKGROUND_POOL_SIZE + DB_BACKGROUND_MAX_OVERFLOW)
#   ... 를 DB_WORKER_PROCESSES 만큼 곱한 값이다.
# DB_MAX_SERVER_CONNECTIONS 를 지정하면 이 계산값이 상한을 넘을 때 **기동이 실패**한다.
# 지정하지 않으면(0) 검증하지 않는다 — 모르는 값을 지어내지 않기 위해서다.

# 요청 처리 엔진
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# 연결 재활용 주기(초). DB/프록시의 wait_timeout 보다 짧아야 한다.
# MySQL 기본은 28800초지만 클라우드 프록시는 보통 300초 안팎에서 끊는다.
# DB_POOL_RECYCLE=280

# 백그라운드 태스크 전용 엔진 (요청 처리 풀과 분리)
# DB_BACKGROUND_POOL_SIZE=10
# DB_BACKGROUND_MAX_OVERFLOW=10
# DB_BACKGROUND_POOL_TIMEOUT=60

# 이 앱을 실행하는 프로세스 수(uvicorn worker + celery worker). 실제 배포 값을 넣어야
# 위 총 연결 수 검증이 의미를 갖는다.
# DB_WORKER_PROCESSES=1

# DB 서버의 max_connections. 0이면 총 연결 수 검증을 건너뛴다.
# DB_MAX_SERVER_CONNECTIONS=0

# =============================================================================
# 마이그레이션 (Alembic)
# =============================================================================
# Alembic 이 사용할 DSN. 미설정 시 위 primary 설정에서 자동 유도한다
# (드라이버만 동기용 pymysql 로 치환 — Alembic 은 비동기 드라이버를 쓸 수 없다).
# 로컬/CI 에서 SQLite 등으로 갈아끼울 때만 명시한다.
# 마이그레이션은 항상 primary 에서 실행된다 (replica 는 읽기 전용).
# ALEMBIC_DATABASE_URL=sqlite:///./test.db

# =============================================================================
# Redis 설정
# 서버 기동 시 ping() 으로 연결을 검증한다 — 실패하면 서버가 시작되지 않는다(DEBUG 와 무관).
# Redis 7.0 이상이어야 한다 — 레이트 리밋이 EXPIRE NX(7.0)를 쓴다. 기동 시 INFO 로 버전을 보고
# 낮으면 멈춘다(INFO 를 막은 관리형 Redis 는 WARNING 만 남기고 계속).
# Celery broker·result backend 도 같은 주소를 쓴다. 캐시·세션 구현은 없다.
# =============================================================================
# Redis 서버 호스트
REDIS_HOST=localhost

# Redis 서버 포트
REDIS_PORT=6379

# Redis 데이터베이스 번호 (0-15)
REDIS_DB=0

# Redis 비밀번호 (설정하지 않으면 인증 없이 접속)
REDIS_PASSWORD=

# =============================================================================
# CORS 설정 (Cross-Origin Resource Sharing)
# =============================================================================
# 허용할 Origin 목록 (JSON 배열 형식)
# 모든 Origin 허용: ["*"]
# 특정 Origin만 허용: ["http://localhost:3000", "https://example.com"]
CORS_ALLOW_ORIGINS=["*"]

# 자격 증명(쿠키, Authorization 헤더) 허용 여부
#
# ⚠️ `CORS_ALLOW_ORIGINS=["*"]` 와 `CORS_ALLOW_CREDENTIALS=true` 는 **함께 쓸 수 없다**.
# CORS 스펙상 무효이고, Starlette 은 이 조합에서 요청 Origin 을 그대로 반영해
# "자격증명 포함 임의 출처 허용"이라는 취약 상태가 된다. config.py 의 validator 가
# 기동 시점에 거부한다 — 이 파일을 그대로 .env 로 복사해도 뜨도록 false 로 둔다.
#
# 쿠키·Authorization 헤더를 쓰려면 위 CORS_ALLOW_ORIGINS 를 구체적인 Origin 으로
# 바꾼 뒤 이 값을 true 로 올린다:
#   CORS_ALLOW_ORIGINS=["http://localhost:3000"]
#   CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_CREDENTIALS=false

# 허용할 HTTP 메서드 (JSON 배열 형식)
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]

# 허용할 HTTP 헤더 (JSON 배열 형식)
CORS_ALLOW_HEADERS=["*"]

# 브라우저(JS)에 노출할 응답 헤더 (JSON 배열 형식)
# CORS_EXPOSE_HEADERS=["X-Total-Count"]

# Preflight 요청 캐시 시간 (초)
CORS_MAX_AGE=600

# =============================================================================
# 로깅 설정
# =============================================================================
# 콘솔(stdout) 로그 출력 스위치. false 면 앱·python main.py 의 uvicorn·Celery 워커 모두
# 콘솔 핸들러를 붙이지 않는다(파일 핸들러는 그대로). 콘솔도 파일도 없으면 기동 시
# stderr 에 경고 한 줄을 남기고 로그는 버려진다. uvicorn CLI(uvicorn main:app·fastapi dev)는
# uvicorn 자체 로깅을 쓰므로 그 줄은 이 값과 무관하다.
LOG_CONSOLE_ENABLED=true

# 파일 로그 출력 활성화 (ENV=staging|production 일 때만 파일 핸들러가 붙는다)
LOG_FILE_ENABLED=true

# 로그 레벨 설정 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# 미설정 시 DEBUG 설정에 따라 자동 결정:
#   - DEBUG=true → DEBUG 레벨
#   - DEBUG=false → INFO 레벨
# 명시적 설정 시 해당 값이 우선 적용됨
# LOG_LEVEL=DEBUG
# LOG_CONSOLE_LEVEL=DEBUG

# 파일 로그 레벨 (파일에는 INFO 이상만 기록하는 것이 일반적)
LOG_FILE_LEVEL=INFO

# SQL 본문과 바인딩 파라미터를 로그에 남길지 (기본 false)
# DEBUG=true 면 유효 로그 레벨이 DEBUG 라 SQLAlchemy·드라이버가 실행 SQL 과 **값**을
# 그대로 찍는다. 그 값에는 비밀번호 해시·토큰·개인정보가 들어간다.
# 쿼리를 눈으로 봐야 할 때만 켜고, 운영에서는 켜지 않는다.
# LOG_SQL_ECHO_ENABLED=true

# 로그 파일 저장 디렉토리 (프로젝트 루트 기준 상대 경로)
LOG_DIR=logs

# 헤더(app=)별 최소 레벨 — Django LOGGING["loggers"][name]["level"] 자리.
# 키는 헤더 이름(기능명·core·celery·utils·migrations·app·uvicorn·sqlalchemy·alembic·ext),
# 값은 DEBUG/INFO/WARNING/ERROR/CRITICAL. 지정 없는 헤더는 LOG_LEVEL 을 따른다.
# 형식·레벨이 틀리면 기동을 멈추고, 모르는 헤더 이름은 경고 한 줄만 남긴다.
# LOG_APP_LEVELS=blog=DEBUG,celery=INFO,sqlalchemy=WARNING

# 파일은 LOG_DIR 아래 고정 이름 — 웹 app.log·error.log, Celery 워커 celery.log·celery-error.log.
# 매일 자정(UTC)에 app.log.2026-10-19 로 넘기고, 하루 안에서 크기를 넘으면 app.log.2026-10-19.1 로 나눈다.
# 하루 안 분할 크기 (MB, 0 = 크기 분할 없음)
LOG_MAX_SIZE_MB=10

# 회전된 파일 보관 일수 — 더 오래된 날짜 파일·분할 파일을 회전 시점에 지운다 (0 = 지우지 않음)
LOG_RETENTION_DAYS=30

# 로그 출력 형식 (str.format 스타일). LogRecord 속성({name}·{funcName}·{lineno} 등)에 더해
# {tzname}(KST/UTC)·{appname}(소스 경로의 앱)·{classname} 을 쓸 수 있다.
# 로드할 때 샘플 레코드로 한 번 렌더해 보므로 모르는 필드·괄호 불일치는 기동을 멈춘다.
# 필수 필드 {asctime}·{levelname}·{appname}·{module}·{classname}·{funcName}·{message} 가 하나라도 없어도 멈춘다.
# 코드 기본값(아래 두 줄 모두): [{asctime} {tzname}] {levelname:5} [app={appname}] [{module}:{classname}:{funcName}:{lineno}] {message}
# 콘솔 — 앱·uvicorn(접속 줄 포함, python main.py·uvicorn main:app 모두)·Celery 워커
# LOG_CONSOLE_FORMAT={asctime} {levelname:8} [{appname}] {module}:{classname}:{funcName} {message}
# 파일 — app.log·error.log·celery.log·celery-error.log (Celery --logfile 도 이 형식)
# LOG_FILE_FORMAT=[{asctime} {tzname}] {levelname:5} [app={appname}] [{module}:{classname}:{funcName}:{lineno}] {message}
# {asctime} 의 strftime 형식(빈 값 금지). ENV=development 에서는 뒤에 .밀리초 가 붙는다.
# LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# =============================================================================
# 미들웨어 설정
# =============================================================================
# 접속 로그 수집 활성화
# true: 모든 API 요청에 대해 접속 로그를 DB에 저장
ACCESS_LOG_ENABLED=true

# 접속 로그 수집 제외 경로 (JSON 배열 형식)
# 헬스체크, 정적 파일 등 로깅이 불필요한 경로 (정확 일치)
# 코드 기본값: ["/health", "/docs", "/redoc", "/openapi.json", "/favicon.ico"]
# ACCESS_LOG_EXCLUDE_PATHS=["/health", "/docs", "/openapi.json", "/admin"]

# 접속 로그 수집 제외 확장자 (JSON 배열 형식)
# 정적 파일 요청은 로깅에서 제외 (접미사 일치)
# 코드 기본값: [".css", ".js", ".ico", ".png", ".jpg", ".jpeg", ".gif", ".svg"]
# ACCESS_LOG_EXCLUDE_EXTENSIONS=[".css", ".js", ".ico", ".png", ".jpg"]

# 접속 로그 보존 기간(일). 매일 03:30(TIME_ZONE 기준) Celery beat 가 이보다 오래된 행을 5,000행씩
# 나눠 지운다(home.purge_expired_access_logs). 0 = 지우지 않는다. 음수는 기동 시 검증 오류.
# beat 프로세스가 떠 있어야 돈다: uv run celery -A app.celery.app beat --loglevel=info
ACCESS_LOG_RETENTION_DAYS=365

# 앞단 신뢰 프록시 수 (접속 로그의 ip_address 를 정한다 — ClientIPResolver)
# 0(기본): X-Forwarded-For·X-Real-IP 를 보지 않고 소켓 주소를 쓴다. 헤더는 누구나 위조할 수 있다.
# N: X-Forwarded-For 의 오른쪽 N번째(= 가장 바깥 신뢰 프록시가 본 주소)를 쓴다.
#    예) nginx 한 대 뒤 → 1, CDN + nginx → 2. 프록시가 XFF 에 덧붙이지 않으면 0 으로 둔다.
#    X-Real-IP 는 N>0 이고 X-Forwarded-For 가 없을 때만 본다.
# ⚠️ 배포 전 확인: 프록시 뒤 배포면 앞단 프록시 단 수로 설정한다. 0 으로 두면 모든 클라이언트가
#    프록시 IP 하나로 보여 접속 로그·로그인 레이트 리밋(API·/admin)이 전체 사용자를 한 사람으로
#    취급한다. 실제보다 크게 잡으면 클라이언트가 보낸 X-Forwarded-For 를 믿어 IP 위조가 가능하다
#    (README 「운영 배포 체크리스트」).
TRUSTED_PROXY_HOPS=0

# 접속 로그 query_string 에서 값을 *** 로 가릴 키 (JSON 배열, 대소문자 무시)
# 코드 기본값: ["password", "token", "access_token", "refresh_token", "secret", "api_key", "code"]
# ACCESS_LOG_SENSITIVE_QUERY_KEYS=["password", "token", "access_token", "refresh_token", "secret", "api_key", "code"]

# =============================================================================
# 세션 설정
# config.SessionSettings 로 로드됨. API 인증은 JWT(Bearer) 라 API 는 쿠키 세션을 쓰지 않는다.
# SESSION_SECRET_KEY 는 /admin 관리 세션 ID 를 Redis 키(admin:sess:{HMAC})로 바꾸는 HMAC 키다.
# =============================================================================
# 세션 쿠키 이름 — 접속 로그 미들웨어가 이 이름의 쿠키 값을 session_id 로 기록한다
# /admin 세션 쿠키 이름(admin_session)과 같으면 기동이 실패한다(관리자 쿠키가 접속 로그에 남는다).
SESSION_COOKIE_NAME=session

# 세션 키 — /admin 관리 세션 ID → Redis 키 HMAC (운영 배포 전 반드시 교체)
# 바꾸면 기존 /admin 로그인 세션이 모두 무효가 된다(다시 로그인).
# 생성 방법:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ test 외 모든 ENV 에서 placeholder(빈 값, your-… 로 시작, change-this 포함)이거나 32자 미만이면
#    **기동이 실패한다**(config.validate_deployment_safety).
SESSION_SECRET_KEY=change-this-session-secret-key

# /admin 관리 세션 만료 (초, 60 이상, 미사용 ≤ 절대가 아니면 기동 실패)
# 절대 만료 — 로그인 시각부터, 요청이 있어도 연장되지 않는다(쿠키 Max-Age 도 이 값). 기본 8시간.
# ADMIN_SESSION_MAX_AGE_SECONDS=28800
# 미사용 만료 — 마지막 요청부터 센다(요청마다 Redis TTL 갱신, 절대 만료를 넘지 않음). 기본 30분.
# ADMIN_SESSION_IDLE_SECONDS=1800

# =============================================================================
# JWT 토큰 설정
# ✅ 인증(app/features/auth)에서 사용됨 — config.JWTSettings 로 로드.
# =============================================================================
# Access Token 서명 키 / Refresh Token 서명 키 (운영 배포 전 반드시 교체)
# 두 키는 서로 달라야 한다. 생성 방법(키마다 한 번씩 실행):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ test 외 모든 ENV 에서 placeholder(빈 값, your-… 로 시작, change-this 포함)·32자 미만이거나
#    ACCESS/REFRESH 키가 같으면 **기동이 실패한다**(config.validate_deployment_safety).
ACCESS_TOKEN_SECRET_KEY=change-this-access-token-secret-key
REFRESH_TOKEN_SECRET_KEY=change-this-refresh-token-secret-key

# Access Token 만료 시간 (분, 기본값: 15분)
# access 토큰은 즉시 폐기 수단이 없다 — 짧게 두고 refresh 회전·폐기로 세션을 관리한다.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token 만료 시간 (일, 기본값: 7일)
# Redis 의 refresh 기록(auth:rt:*)·family 폐기 표시의 TTL 도 이 값이다.
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 알고리즘 (기본값: HS256) — HS256·HS384·HS512 만 허용한다(그 밖의 값은 기동 실패).
# HS384·HS512 는 키가 각각 48·64바이트 이상이어야 PyJWT 가 경고하지 않는다.
# JWT_ALGORITHM=HS256

# 발급자(iss)·대상(aud) — 검증 시 일치해야 한다. 같은 키를 쓰는 다른 서비스의 토큰을 거부한다.
# JWT_ISSUER=fastapi-project
# JWT_AUDIENCE=fastapi-project-api

# 서버 간 시계 차이 허용(초, 기본값: 5) — exp·nbf·iat 판정에 더한다.
# JWT_LEEWAY_SECONDS=5

# 인증 레이트 리밋 (Redis 고정 창, 초과 시 429 + Retry-After)
# 로그인: 창(AUTH_LOGIN_WINDOW_SECONDS)마다 ip+username 당 AUTH_LOGIN_MAX_ATTEMPTS 회,
#         ip 당 AUTH_LOGIN_IP_MAX_ATTEMPTS 회. 로그인 성공 시 ip+username 카운터를 지운다.
# 회원가입: 창(AUTH_REGISTER_WINDOW_SECONDS)마다 ip 당 AUTH_REGISTER_MAX_ATTEMPTS 회.
# /admin 로그인도 같은 한도를 쓴다(키 접두사가 admin-login: 이라 API 로그인과 카운터를 공유하지 않는다).
# ip 는 접속 로그와 같은 TRUSTED_PROXY_HOPS 규칙으로 정한다 — 프록시 뒤에서 0 이면 모두 한 ip 로 센다.
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_IP_MAX_ATTEMPTS=20
# AUTH_LOGIN_WINDOW_SECONDS=60
# AUTH_REGISTER_MAX_ATTEMPTS=5
# AUTH_REGISTER_WINDOW_SECONDS=3600
